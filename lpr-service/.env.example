# Backend selection: stub | yolo
LPR_BACKEND=stub

# Stub backend (returns this plate at given confidence)
STUB_PLATE=12345678
STUB_CONFIDENCE=0.95

# YOLO backend
YOLO_DETECTOR_WEIGHTS=/app/models/plate_detector.pt
YOLO_DEVICE=cpu            # cpu | cuda:0
YOLO_IMGSZ=640
YOLO_CONF=0.35

# OCR backend
OCR_LANG=en                # en is fine — Israeli plates are numeric only
OCR_USE_GPU=false

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
