# Device identity
DEVICE_ID=00000000-0000-0000-0000-000000000000

# Supabase (service key — agent only, never client-side)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Relay (Modbus TCP)
RELAY_IP=192.168.1.200
RELAY_PORT=502
RELAY_UNIT_ID=1
RELAY_CHANNEL=0
RELAY_PULSE_MS=600

# Camera
CAMERA_RTSP_URL=rtsp://user:pass@192.168.1.10:554/Streaming/Channels/101
CAMERA_FRAME_INTERVAL_MS=400

# LPR service (HTTP)
LPR_ENDPOINT=http://127.0.0.1:8000/recognize
LPR_TIMEOUT_MS=4000

# Decision logic
CONFIDENCE_THRESHOLD=0.80
COOLDOWN_SECONDS=30

# Local cache
CACHE_DB_PATH=./data/cache.sqlite
SYNC_INTERVAL_MS=60000
HEARTBEAT_INTERVAL_MS=30000

# Storage (Supabase Storage bucket)
SNAPSHOT_BUCKET=plate-snapshots
SNAPSHOT_DIR=./data/snapshots

# Logging
LOG_LEVEL=info

# Timezone (all decisions made in this zone)
TZ=Asia/Jerusalem
